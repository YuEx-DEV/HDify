<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_preview_bottom_sheet"
    android:paddingBottom="24dp">

    <!-- Drag Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header Section with Title, Subtitle & Circular Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_advanced_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_advanced_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_advanced_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/dialog_advanced_subtitle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_advanced"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_preview_close_btn"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/action_close"
            android:clickable="true"
            android:focusable="true"
            app:tint="?android:attr/textColorPrimary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingBottom="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp">

            <!-- Engine Label -->
            <TextView
                android:id="@+id/tv_engine_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/engine_selector_label"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Engine Toggle Group -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_engine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cornerRadius="24dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:layout_constraintTop_toBottomOf="@id/tv_engine_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_engine_cugan"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/engine_realcugan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_engine_esrgan"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/engine_realesrgan" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Model Label -->
            <TextView
                android:id="@+id/tv_model_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/model_selector_label"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/toggle_engine"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Model Chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_models"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:layout_constraintTop_toBottomOf="@id/tv_model_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Tile Size Label -->
            <TextView
                android:id="@+id/tv_tile_size_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textStyle="bold"
                tools:text="Ukuran Tile: Otomatis"
                app:layout_constraintTop_toBottomOf="@id/chip_group_models"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_tile_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="400"
                android:stepSize="50"
                android:value="0"
                app:layout_constraintTop_toBottomOf="@id/tv_tile_size_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- FP16 Toggle -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_fp16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:checked="true"
                android:text="@string/toggle_fp16"
                app:layout_constraintTop_toBottomOf="@id/slider_tile_size"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_fp16_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/toggle_fp16_desc"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary"
                app:layout_constraintTop_toBottomOf="@id/switch_fp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- TTA Toggle -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_tta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:checked="false"
                android:text="@string/toggle_tta"
                app:layout_constraintTop_toBottomOf="@id/tv_fp16_desc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_tta_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/toggle_tta_desc"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary"
                app:layout_constraintTop_toBottomOf="@id/switch_tta"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply_advanced"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/btn_save_apply"
                android:textStyle="bold"
                app:cornerRadius="25dp"
                android:textColor="@color/btn_primary_text"
                app:iconTint="@color/btn_primary_icon"
                app:backgroundTint="@color/btn_primary_bg"
                app:layout_constraintTop_toBottomOf="@id/tv_tta_desc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
