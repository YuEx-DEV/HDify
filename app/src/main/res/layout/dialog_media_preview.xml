<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_preview_bottom_sheet"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_preview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Chisato - Trance #lycorisrecoil" />

            <TextView
                android:id="@+id/tv_preview_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="Video HD (Tanpa Watermark) • VIDEO" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_preview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_preview_close_btn"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            app:tint="?android:attr/textColorPrimary"
            android:contentDescription="@string/action_close"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Preview View Container (Rounded Modern Screen) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_preview_viewport"
        android:layout_width="match_parent"
        android:layout_height="330dp"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1.2dp"
        app:strokeColor="@color/liquid_glass_stroke"
        app:cardBackgroundColor="#0A0A0C">

        <FrameLayout
            android:id="@+id/layout_preview_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Backdrop Image / Poster / Album Artwork -->
            <ImageView
                android:id="@+id/iv_preview_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Poster Preview" />

            <!-- Video Stream View -->
            <VideoView
                android:id="@+id/vv_preview_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Loading Spinner -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_preview_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorSize="44dp"
                app:trackThickness="4dp" />

            <!-- Play/Pause Overlay Indicator -->
            <ImageView
                android:id="@+id/iv_preview_play"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_play_badge"
                android:padding="16dp"
                android:src="@drawable/ic_play"
                android:visibility="gone"
                app:tint="@android:color/white" />

            <!-- Sleek Minimalist Bottom Controller Bar for Video / Audio -->
            <LinearLayout
                android:id="@+id/layout_video_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#CC0B0B0E"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iv_control_play_pause"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_pause"
                    app:tint="@android:color/white" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_video_timeline"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="12dp"
                    app:trackCornerRadius="2dp"
                    app:trackColor="#44FFFFFF"
                    app:indicatorColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_video_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    tools:text="00:04 / 00:22" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Tap Hint -->
    <TextView
        android:id="@+id/tv_preview_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/preview_hint_tap"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?android:attr/textColorSecondary" />

    <!-- Download Action Button inside Dialog -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_preview_download"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:text="@string/downloader_btn_download"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textStyle="bold"
        app:cornerRadius="18dp"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconPadding="10dp" />

</LinearLayout>
