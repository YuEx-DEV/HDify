<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_margin_horizontal"
            android:paddingTop="@dimen/screen_margin_vertical">

            <!-- Hero Badge -->
            <TextView
                android:id="@+id/tv_edition_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_liquid_glow_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:gravity="center_vertical"
                app:drawableStartCompat="@drawable/ic_hdify_logo"
                app:drawableTint="@color/liquid_badge_text"
                android:drawablePadding="6dp"
                android:text="@string/home_hero_badge"
                android:textColor="@color/liquid_badge_text"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- App Title & Subtitle -->
            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_edition_badge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_app_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="@string/home_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary"
                app:layout_constraintTop_toBottomOf="@id/tv_app_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Hardware Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hardware_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:layout_constraintTop_toBottomOf="@id/tv_app_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/iv_hw_icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_liquid_icon_container"
                        android:padding="8dp"
                        android:src="@drawable/ic_hardware"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/hw_status_title"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_hw_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:text="@string/hw_status_checking"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_hw_icon"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Image Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:layout_constraintTop_toBottomOf="@id/card_hardware_status"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/iv_image_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_liquid_icon_container"
                        android:padding="11dp"
                        android:src="@drawable/ic_image"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/card_image_title"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_image_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:text="@string/card_image_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintTop_toTopOf="@id/iv_image_icon"
                        app:layout_constraintStart_toEndOf="@id/iv_image_icon"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_image_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/card_image_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?android:attr/textColorSecondary"
                        app:layout_constraintTop_toBottomOf="@id/tv_image_title"
                        app:layout_constraintStart_toStartOf="@id/tv_image_title"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/badge_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_liquid_glow_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/home_badge_image"
                        android:textColor="@color/liquid_badge_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tv_image_desc"
                        app:layout_constraintStart_toStartOf="@id/tv_image_title" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Background Remover Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_bg_remover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:layout_constraintTop_toBottomOf="@id/card_image"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/iv_bg_remover_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_liquid_icon_container"
                        android:padding="11dp"
                        android:src="@drawable/ic_cut"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/card_bg_remover_title"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_bg_remover_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:text="@string/card_bg_remover_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintTop_toTopOf="@id/iv_bg_remover_icon"
                        app:layout_constraintStart_toEndOf="@id/iv_bg_remover_icon"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_bg_remover_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/card_bg_remover_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?android:attr/textColorSecondary"
                        app:layout_constraintTop_toBottomOf="@id/tv_bg_remover_title"
                        app:layout_constraintStart_toStartOf="@id/tv_bg_remover_title"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/badge_bg_remover"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_liquid_glow_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/home_badge_bg"
                        android:textColor="@color/liquid_badge_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tv_bg_remover_desc"
                        app:layout_constraintStart_toStartOf="@id/tv_bg_remover_title" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Video Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_video"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:layout_constraintTop_toBottomOf="@id/card_bg_remover"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/iv_video_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_liquid_icon_container"
                        android:padding="11dp"
                        android:src="@drawable/ic_video"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/card_video_title"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_video_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:text="@string/card_video_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintTop_toTopOf="@id/iv_video_icon"
                        app:layout_constraintStart_toEndOf="@id/iv_video_icon"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_video_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/card_video_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?android:attr/textColorSecondary"
                        app:layout_constraintTop_toBottomOf="@id/tv_video_title"
                        app:layout_constraintStart_toStartOf="@id/tv_video_title"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/badge_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_liquid_glow_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/home_badge_video"
                        android:textColor="@color/liquid_badge_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tv_video_desc"
                        app:layout_constraintStart_toStartOf="@id/tv_video_title" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Media Downloader Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_downloader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:layout_constraintTop_toBottomOf="@id/card_video"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/iv_downloader_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_liquid_icon_container"
                        android:padding="11dp"
                        android:src="@drawable/ic_download"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/card_downloader_title"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_downloader_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:text="@string/card_downloader_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintTop_toTopOf="@id/iv_downloader_icon"
                        app:layout_constraintStart_toEndOf="@id/iv_downloader_icon"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_downloader_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/card_downloader_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?android:attr/textColorSecondary"
                        app:layout_constraintTop_toBottomOf="@id/tv_downloader_title"
                        app:layout_constraintStart_toStartOf="@id/tv_downloader_title"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/badge_downloader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_liquid_glow_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/home_badge_downloader"
                        android:textColor="@color/liquid_badge_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tv_downloader_desc"
                        app:layout_constraintStart_toStartOf="@id/tv_downloader_title" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Video Compressor Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_compressor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:layout_constraintTop_toBottomOf="@id/card_downloader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/iv_compressor_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_liquid_icon_container"
                        android:padding="11dp"
                        android:src="@drawable/ic_compress"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/card_compressor_title"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_compressor_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:text="@string/card_compressor_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintTop_toTopOf="@id/iv_compressor_icon"
                        app:layout_constraintStart_toEndOf="@id/iv_compressor_icon"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_compressor_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/card_compressor_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?android:attr/textColorSecondary"
                        app:layout_constraintTop_toBottomOf="@id/tv_compressor_title"
                        app:layout_constraintStart_toStartOf="@id/tv_compressor_title"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/badge_compressor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_liquid_glow_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/compressor_badge_text"
                        android:textColor="@color/liquid_badge_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tv_compressor_desc"
                        app:layout_constraintStart_toStartOf="@id/tv_compressor_title" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Developer Credit Footer Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_home_developer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_large"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:layout_constraintTop_toBottomOf="@id/card_compressor"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/iv_home_tiktok"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_liquid_icon_container"
                        android:padding="8dp"
                        android:src="@drawable/ic_tiktok"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="TikTok Creator"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_home_dev_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:text="@string/settings_dev_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_home_tiktok"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_home_dev_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_dev_credit"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?android:attr/textColorSecondary"
                        app:layout_constraintTop_toBottomOf="@id/tv_home_dev_title"
                        app:layout_constraintStart_toStartOf="@id/tv_home_dev_title"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
