<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_medium">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/color_picker_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/color_picker_subtitle"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?android:attr/textColorSecondary" />

    <!-- Color Preview Swatch Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1.2dp"
        app:strokeColor="@color/liquid_glass_stroke">

        <FrameLayout
            android:id="@+id/view_color_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D32F2F">

            <TextView
                android:id="@+id/tv_hex_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#80000000"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="#D32F2F"
                android:textColor="@android:color/white"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Palette Swatches -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:text="@string/color_picker_popular"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_palette_swatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- Red Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="@string/color_picker_red"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textStyle="bold"
            android:textColor="#E53935" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_red"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="255"
            android:stepSize="1"
            android:value="211"
            app:thumbColor="#E53935"
            app:trackColorActive="#E53935" />

        <TextView
            android:id="@+id/tv_val_red"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="211"
            android:textAppearance="?attr/textAppearanceBodySmall" />

    </LinearLayout>

    <!-- Green Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="@string/color_picker_green"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textStyle="bold"
            android:textColor="#43A047" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_green"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="255"
            android:stepSize="1"
            android:value="47"
            app:thumbColor="#43A047"
            app:trackColorActive="#43A047" />

        <TextView
            android:id="@+id/tv_val_green"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="47"
            android:textAppearance="?attr/textAppearanceBodySmall" />

    </LinearLayout>

    <!-- Blue Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="@string/color_picker_blue"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textStyle="bold"
            android:textColor="#1E88E5" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_blue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="255"
            android:stepSize="1"
            android:value="47"
            app:thumbColor="#1E88E5"
            app:trackColorActive="#1E88E5" />

        <TextView
            android:id="@+id/tv_val_blue"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="47"
            android:textAppearance="?attr/textAppearanceBodySmall" />

    </LinearLayout>

    <!-- Custom HEX Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_hex"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="@string/color_picker_hex_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_hex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLength="7"
            android:text="#D32F2F" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            app:cornerRadius="22dp"
            android:text="@string/color_picker_btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_small"
            app:cornerRadius="22dp"
            android:text="@string/color_picker_btn_apply" />

    </LinearLayout>

</LinearLayout>
