<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/log_screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tv_logs_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingTop="@dimen/screen_margin_vertical"
        android:text="@string/log_screen_title"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Action Toolbar (Copy, Share, Clear, Refresh) -->
    <LinearLayout
        android:id="@+id/layout_log_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingTop="@dimen/spacing_small"
        app:layout_constraintTop_toBottomOf="@id/tv_logs_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_logs"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:iconSize="16dp"
            app:iconPadding="2dp"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_copy"
            android:text="@string/action_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_logs"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:iconSize="16dp"
            app:iconPadding="2dp"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_share"
            android:text="@string/action_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_logs"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:iconSize="16dp"
            app:iconPadding="2dp"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_delete"
            android:text="@string/action_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh_logs"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:iconSize="16dp"
            app:iconPadding="2dp"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_refresh"
            android:text="@string/action_refresh" />

    </LinearLayout>

    <!-- Filter Chips Horizontal Scroll -->
    <HorizontalScrollView
        android:id="@+id/scroll_filter_chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingVertical="@dimen/spacing_small"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layout_log_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_info"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_info" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_warn"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_warn" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_error"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_error" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_crashes"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_crashes" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- RecyclerView for Logs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_logs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_small"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/scroll_filter_chips"
        app:layout_constraintBottom_toTopOf="@id/layout_debug_test"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State for Logs -->
    <TextView
        android:id="@+id/tv_empty_logs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/spacing_large"
        android:text="@string/logs_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scroll_filter_chips"
        app:layout_constraintBottom_toTopOf="@id/layout_debug_test"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Debug Crash Testing Section (Visible ONLY in debug build) -->
    <LinearLayout
        android:id="@+id/layout_debug_test"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingVertical="@dimen/spacing_small"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debug_section_title"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorError"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test_kotlin_crash"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_small"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="center"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/btn_test_kotlin_crash"
                android:textColor="?attr/colorError"
                app:strokeColor="?attr/colorError" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test_native_crash"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="center"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/btn_test_native_crash"
                android:textColor="?attr/colorError"
                app:strokeColor="?attr/colorError" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
