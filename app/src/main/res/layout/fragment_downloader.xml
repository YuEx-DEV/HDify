<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/downloader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="?android:attr/textColorPrimary"
            android:contentDescription="@string/action_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/downloader_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/downloader_subtitle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="108dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp">

            <!-- Supported Platform Chips (Single line horizontal scroll) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginBottom="16dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_platforms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_tiktok"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TikTok"
                        app:chipIcon="@drawable/ic_video"
                        app:chipIconTint="@color/chip_icon_tint"
                        app:chipStrokeColor="?attr/colorOutlineVariant"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="12dp"
                        android:clickable="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_youtube"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube"
                        app:chipIcon="@drawable/ic_video"
                        app:chipIconTint="@color/chip_icon_tint"
                        app:chipStrokeColor="?attr/colorOutlineVariant"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="12dp"
                        android:clickable="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_yt_music"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YT Music"
                        app:chipIcon="@drawable/ic_music"
                        app:chipIconTint="@color/chip_icon_tint"
                        app:chipStrokeColor="?attr/colorOutlineVariant"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="12dp"
                        android:clickable="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_soundcloud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SoundCloud"
                        app:chipIcon="@drawable/ic_music"
                        app:chipIconTint="@color/chip_icon_tint"
                        app:chipStrokeColor="?attr/colorOutlineVariant"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="12dp"
                        android:clickable="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_instagram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instagram"
                        app:chipIcon="@drawable/ic_image"
                        app:chipIconTint="@color/chip_icon_tint"
                        app:chipStrokeColor="?attr/colorOutlineVariant"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="12dp"
                        android:clickable="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_twitter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="X (Twitter)"
                        app:chipIcon="@drawable/ic_share"
                        app:chipIconTint="@color/chip_icon_tint"
                        app:chipStrokeColor="?attr/colorOutlineVariant"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="12dp"
                        android:clickable="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_douyin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Douyin"
                        app:chipIcon="@drawable/ic_video"
                        app:chipIconTint="@color/chip_icon_tint"
                        app:chipStrokeColor="?attr/colorOutlineVariant"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="12dp"
                        android:clickable="false" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <!-- URL Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="4dp"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:cardBackgroundColor="@color/liquid_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/downloader_input_hint"
                        app:startIconDrawable="@drawable/ic_link"
                        app:endIconMode="clear_text"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:maxLines="2" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Buttons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_paste"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="@string/downloader_btn_paste"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_paste"
                            app:cornerRadius="24dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_analyze"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1.2"
                            android:layout_marginStart="6dp"
                            android:text="@string/downloader_btn_analyze"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_refresh"
                            app:cornerRadius="24dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Clipboard Auto-Detection Suggestion Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_clipboard_suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:cardBackgroundColor="@color/liquid_card_bg"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_paste"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/downloader_clipboard_detected"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tv_clipboard_url"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?android:attr/textColorSecondary"
                            android:maxLines="1"
                            android:ellipsize="middle"
                            tools:text="https://vt.tiktok.com/ZSbs15chD/" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clipboard_use"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/downloader_btn_paste"
                        android:textSize="12sp"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Loading Indicator for Analysis -->
            <LinearLayout
                android:id="@+id/layout_analyzing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingVertical="24dp"
                tools:visibility="visible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorSize="36dp"
                    app:trackThickness="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/downloader_analyzing"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <!-- Media Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_media_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="6dp"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:cardBackgroundColor="@color/liquid_card_bg"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Thumbnail & Info Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <!-- 3:4 Portrait Thumbnail with Play Overlay & Clickable preview -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/container_thumb_preview"
                            android:layout_width="86dp"
                            android:layout_height="116dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1.2dp"
                            app:strokeColor="@color/liquid_glass_stroke"
                            app:cardBackgroundColor="@color/liquid_card_bg">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/iv_media_thumb"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop" />

                                <ImageView
                                    android:id="@+id/iv_play_badge"
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_play_badge"
                                    android:padding="8dp"
                                    android:src="@drawable/ic_play"
                                    app:tint="@android:color/white" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:background="#AA000000"
                                    android:gravity="center"
                                    android:paddingVertical="3dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/label_preview"
                                        android:textColor="@android:color/white"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                            </FrameLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Title, Author, Platform Badge -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/chip_platform_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:background="@drawable/bg_platform_badge"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                tools:text="TikTok" />

                            <TextView
                                android:id="@+id/tv_media_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"
                                android:lineSpacingExtra="2dp"
                                tools:text="Awesome video caption or title goes here..." />

                            <TextView
                                android:id="@+id/tv_media_author"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?android:attr/textColorSecondary"
                                tools:text="@username" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Divider -->
                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Multi-slide selector (visible if multiple slides/carousels detected) -->
                    <LinearLayout
                        android:id="@+id/layout_slides_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/downloader_carousel_title"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:overScrollMode="never"
                            android:layout_marginTop="6dp">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chip_group_slides"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleLine="true"
                                app:singleSelection="true" />

                        </HorizontalScrollView>

                    </LinearLayout>

                    <!-- Format & Quality Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/downloader_select_quality"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textStyle="bold" />

                    <!-- Options Container (populated dynamically with sleek cards) -->
                    <LinearLayout
                        android:id="@+id/layout_options_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <!-- Action Buttons: Download (Primary) & Preview (Secondary) -->
                    <LinearLayout
                        android:id="@+id/layout_actions_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_download"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="@string/downloader_btn_download"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold"
                            android:maxLines="1"
                            app:cornerRadius="25dp"
                            app:icon="@drawable/ic_download"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_preview_media"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/downloader_preview_title"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold"
                            android:maxLines="1"
                            app:cornerRadius="25dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp" />

                    </LinearLayout>

                    <!-- Embedded Download Progress Section -->
                    <LinearLayout
                        android:id="@+id/layout_download_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_progress_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/downloader_downloading_title"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_download_percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                tools:text="45%" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_download"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            app:trackCornerRadius="4dp" />

                        <TextView
                            android:id="@+id/tv_download_bytes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?android:attr/textColorSecondary"
                            tools:text="12.5 MB / 25.0 MB" />

                    </LinearLayout>

                    <!-- Embedded Success Section -->
                    <LinearLayout
                        android:id="@+id/layout_download_success"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp"
                            android:background="@drawable/bg_success_banner">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/status_green" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/downloader_success_title"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textStyle="bold"
                                    android:textColor="@color/status_green" />

                                <TextView
                                    android:id="@+id/tv_success_desc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/downloader_success_desc"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?android:attr/textColorSecondary" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Big Upscaler CTA -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_open_upscaler"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="14dp"
                            android:text="@string/downloader_btn_open_video_upscaler"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold"
                            app:cornerRadius="25dp"
                            app:icon="@drawable/ic_auto_awesome"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_download_again"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            app:cornerRadius="22dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/downloader_btn_download_again" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Feature Guide Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_features_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:cardBackgroundColor="@color/liquid_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/downloader_capabilities_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/downloader_capabilities_desc"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
