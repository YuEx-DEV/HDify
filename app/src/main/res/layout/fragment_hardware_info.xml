<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hardware_info_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/hw_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_hw_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_margin_horizontal"
            android:paddingTop="@dimen/screen_margin_vertical">

            <TextView
                android:id="@+id/tv_hw_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hardware_info_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- GPU Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gpu_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:cardBackgroundColor="@color/liquid_card_bg"
                app:layout_constraintTop_toBottomOf="@id/tv_hw_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gpu_section_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <!-- GPU Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gpu_name_label"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_gpu_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <!-- GPU Type -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gpu_type_label"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_gpu_type"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <!-- Vulkan API -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gpu_api_label"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_gpu_api"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <!-- Driver Version -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gpu_driver_label"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_gpu_driver"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <!-- Memory Heap -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gpu_heap_label"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_gpu_heap"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <!-- FP16 Storage -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gpu_fp16_storage_label"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_gpu_fp16_storage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <!-- FP16 Arithmetic -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gpu_fp16_arith_label"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_gpu_fp16_arith"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <!-- GPU Count -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gpu_count_label"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_gpu_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:gravity="end"
                            android:text="@string/placeholder_dash"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Codec Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_codec_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/liquid_glass_stroke"
                app:cardBackgroundColor="@color/liquid_card_bg"
                app:layout_constraintTop_toBottomOf="@id/card_gpu_info"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/codec_section_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <!-- AVC Dec -->
                    <TextView
                        android:id="@+id/tv_codec_avc_dec"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/codec_avc_dec"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <!-- AVC Enc -->
                    <TextView
                        android:id="@+id/tv_codec_avc_enc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/codec_avc_enc"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <!-- HEVC Dec -->
                    <TextView
                        android:id="@+id/tv_codec_hevc_dec"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/codec_hevc_dec"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <!-- HEVC Enc -->
                    <TextView
                        android:id="@+id/tv_codec_hevc_enc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/codec_hevc_enc"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom Action Layout (UI-R1) -->
    <LinearLayout
        android:id="@+id/layout_hw_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingVertical="@dimen/spacing_small"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_self_test"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/btn_self_test" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_diagnostics"
            style="?attr/materialButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/spacing_small"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/btn_export_diagnostics" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
