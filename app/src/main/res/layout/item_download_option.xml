<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_option"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeWidth="1.2dp"
    app:strokeColor="@color/liquid_glass_stroke"
    app:cardBackgroundColor="@color/liquid_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Icon Container -->
        <FrameLayout
            android:id="@+id/layout_icon_container"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_platform_badge">

            <ImageView
                android:id="@+id/iv_option_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_video"
                app:tint="?attr/colorPrimary" />

        </FrameLayout>

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_option_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                tools:text="Video HD" />

            <TextView
                android:id="@+id/tv_option_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="Tanpa Watermark" />

        </LinearLayout>

        <!-- Badge -->
        <TextView
            android:id="@+id/tv_option_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_platform_badge"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            tools:text="HD" />

        <!-- Selection Check/Radio Icon -->
        <ImageView
            android:id="@+id/iv_option_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_circle"
            app:tint="?attr/colorPrimary"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
