    <string name="dialog_ai_models_title">Katalog Model &amp; Engine AI</string>
    <string name="dialog_ai_models_subtitle">Pemrosesan Lokal • Privasi Terjamin • Tanpa Server Cloud</string>
    <string name="dialog_ai_models_faq_title">Informasi Ukuran Aplikasi</string>
    <string name="dialog_ai_models_faq_desc">HDify memuat seluruh model deep learning dan engine akselerasi Vulkan secara mandiri di dalam aplikasi. Semua pemrosesan berlangsung sepenuhnya di perangkat tanpa koneksi internet dan tanpa pengiriman data ke server eksternal.</string>
    <string name="dialog_ai_models_cugan_title">Real-CUGAN SE &amp; Pro</string>
    <string name="dialog_ai_models_cugan_badge">18 Model • ~40.5 MB</string>
    <string name="dialog_ai_models_cugan_desc">Model super-resolusi untuk ilustrasi dan konten 2D dengan rekonstruksi garis presisi tinggi.</string>
    <string name="dialog_ai_models_cugan_details">• Model SE: Dioptimalkan untuk efisiensi perangkat mobile (x2, x3, x4)\n• Model Pro: Rekonstruksi detail maksimal (x2, x3)</string>
    <string name="dialog_ai_models_esrgan_title">Real-ESRGAN</string>
    <string name="dialog_ai_models_esrgan_badge">5 Model • ~46.0 MB</string>
    <string name="dialog_ai_models_esrgan_desc">Model super-resolusi umum untuk restorasi foto nyata, lanskap, dan tekstur alami.</string>
    <string name="dialog_ai_models_esrgan_details">• realesrgan-x4plus: Model komprehensif untuk foto realistis\n• realesrgan-x4plus-anime: Dioptimalkan untuk ilustrasi kompleks\n• realesr-animevideov3: Model inferensi cepat untuk frame video</string>
    <string name="dialog_ai_models_rife_title">RIFE v4.6 FlowNet</string>
    <string name="dialog_ai_models_rife_badge">10.6 MB • 60/120 FPS</string>
    <string name="dialog_ai_models_rife_desc">Model interpolasi frame berbasis optical flow untuk meningkatkan kelancaran video hingga 60 atau 120 FPS.</string>
    <string name="dialog_ai_models_rife_details">• rife-v4.6/flownet: Estimasi gerakan antar frame secara real-time on-device</string>
    <string name="dialog_ai_models_vulkan_title">Pustaka Komputasi Vulkan (Universal ABI)</string>
    <string name="dialog_ai_models_vulkan_badge">Universal • ~120+ MB</string>
    <string name="dialog_ai_models_vulkan_desc">Mencakup pustaka native C++ 64-bit dan 32-bit untuk kompatibilitas penuh di berbagai arsitektur prosesor:</string>
    <string name="dialog_ai_models_vulkan_details">• arm64-v8a: Perangkat Android modern\n• armeabi-v7a: Perangkat Android 32-bit\n• x86_64: Emulator Android dan perangkat PC\n• x86: Emulator 32-bit</string>
    <string name="dialog_ai_models_summary_title">Ringkasan Sistem &amp; Privasi</string>
    <string name="dialog_ai_models_summary_desc">• Total Model: 24+ model neural network lokal\n• Privasi: Pemrosesan 100% di perangkat tanpa koneksi cloud\n• Efisiensi: Bebas kuota internet untuk seluruh proses rendering\n• Akselerasi: Komputasi GPU Vulkan untuk performa optimal</string>
