<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HDify" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background_liquid</item>
        <item name="colorSurface">@color/liquid_card_bg</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/liquid_card_stroke</item>
        <item name="android:textColorPrimary">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurfaceVariant</item>

        <item name="materialCardViewStyle">@style/Widget.HDify.Card</item>
        <item name="materialButtonStyle">@style/Widget.HDify.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.HDify.BottomNavigationView</item>
    </style>

    <style name="Widget.HDify.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_text_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.HDify.PillIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.HDify.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.HDify.BottomNav.Inactive</item>
        <item name="android:background">@drawable/bg_liquid_dock</item>
        <item name="elevation">12dp</item>
    </style>

    <style name="TextAppearance.HDify.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.HDify.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.HDify.PillIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/liquid_nav_active_indicator</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HDify.Pill</item>
    </style>

    <style name="ShapeAppearance.HDify.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.HDify.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/liquid_glass_stroke</item>
        <item name="cardBackgroundColor">@color/liquid_card_bg</item>
        <item name="android:stateListAnimator">@animator/m3_touch_scale</item>
    </style>

    <style name="Widget.HDify.Button" parent="Widget.Material3.Button">
        <item name="android:stateListAnimator">@animator/m3_touch_scale</item>
    </style>
</resources>
