    <string name="menu_ai_models_title">AI Models &amp; Engine Catalog</string>
    <string name="menu_ai_models_desc">List of 24+ local neural network models and NCNN Vulkan compute libraries</string>
    <string name="dialog_ai_models_title">AI Models &amp; Engine Catalog</string>
    <string name="dialog_ai_models_subtitle">On-Device Processing • Guaranteed Privacy • Zero Cloud Server</string>
    <string name="dialog_ai_models_faq_title">Application Size Information</string>
    <string name="dialog_ai_models_faq_desc">HDify bundles all deep learning models and Vulkan acceleration engines directly within the app. All processing runs entirely on-device without internet connection and without transmitting data to external servers.</string>
    <string name="dialog_ai_models_cugan_title">Real-CUGAN SE &amp; Pro</string>
    <string name="dialog_ai_models_cugan_badge">18 Models • ~40.5 MB</string>
    <string name="dialog_ai_models_cugan_desc">Super-resolution model for illustrations and 2D content with high-precision line reconstruction.</string>
    <string name="dialog_ai_models_cugan_details">• SE Models: Optimized for mobile efficiency (x2, x3, x4)\n• Pro Models: Maximum detail reconstruction (x2, x3)</string>
    <string name="dialog_ai_models_esrgan_title">Real-ESRGAN</string>
    <string name="dialog_ai_models_esrgan_badge">5 Models • ~46.0 MB</string>
    <string name="dialog_ai_models_esrgan_desc">General super-resolution model for restoring real photos, landscapes, and natural textures.</string>
    <string name="dialog_ai_models_esrgan_details">• realesrgan-x4plus: Comprehensive model for realistic photos\n• realesrgan-x4plus-anime: Optimized for complex illustrations\n• realesr-animevideov3: Fast inference model for video frames</string>
    <string name="dialog_ai_models_rife_title">RIFE v4.6 FlowNet</string>
    <string name="dialog_ai_models_rife_badge">10.6 MB • 60/120 FPS</string>
    <string name="dialog_ai_models_rife_desc">Optical flow frame interpolation model to enhance video smoothness up to 60 or 120 FPS.</string>
    <string name="dialog_ai_models_rife_details">• rife-v4.6/flownet: Real-time on-device inter-frame motion estimation</string>
    <string name="dialog_ai_models_vulkan_title">Vulkan Compute Libraries (Universal ABI)</string>
    <string name="dialog_ai_models_vulkan_badge">Universal • ~120+ MB</string>
    <string name="dialog_ai_models_vulkan_desc">Includes 64-bit and 32-bit native C++ libraries for full compatibility across processor architectures:</string>
    <string name="dialog_ai_models_vulkan_details">• arm64-v8a: Modern Android devices\n• armeabi-v7a: 32-bit Android devices\n• x86_64: Android emulators and PC devices\n• x86: 32-bit emulators</string>
    <string name="dialog_ai_models_summary_title">System Summary &amp; Privacy</string>
    <string name="dialog_ai_models_summary_desc">• Total Models: 24+ on-device neural network models\n• Privacy: 100% on-device processing with zero cloud connection\n• Efficiency: Zero internet data usage during AI rendering\n• Acceleration: Vulkan GPU compute for optimal performance</string>
