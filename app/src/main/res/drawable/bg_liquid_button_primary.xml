<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/liquid_btn_start"
                android:centerColor="@color/liquid_btn_mid"
                android:endColor="@color/liquid_btn_end"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/liquid_btn_stroke" />
        </shape>
    </item>
</ripple>
